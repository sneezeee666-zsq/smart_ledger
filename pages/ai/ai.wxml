<view class="container theme-{{theme}}" style="{{themeStyle}}">

  <!-- ==================== 分析卡 ====================
       与「我的」的品牌卡同一套令牌（--hero-top/-grad/-glow）：
       两块深色卡片在任何主题下都同色。 -->
  <view class="hero">
    <view class="hero-glow"></view>

    <view class="hero-top">
      <view class="mark">
        <image class="mark-img" src="/assets/icons/ai-mark.png" mode="aspectFit" />
      </view>
      <view class="hero-text">
        <text class="hero-name">消费分析</text>
        <text class="hero-desc">把最近一段时间的收支汇总成几条要点</text>
      </view>
    </view>

    <button
      class="hero-cta"
      hover-class="hero-cta-hover"
      hover-stay-time="60"
      bindtap="onAnalyze"
      disabled="{{analyzing}}"
    >{{analyzing ? '分析中…' : '开始分析'}}</button>

    <text class="hero-note">统计范围：{{scopeText}}</text>

    <!-- 统计范围切换：近 7 天 / 近 30 天 -->
    <view class="scope-switch">
      <view
        class="scope-item {{scopeDays === item.days ? 'active' : ''}}"
        wx:for="{{scopes}}"
        wx:key="days"
        data-days="{{item.days}}"
        bindtap="onSwitchScope"
      >{{item.label}}</view>
    </view>

    <!-- ⚠️ 必须写这句：跨月结论按自然月算，切到「近 7 天」后它照样出现。
         不说明的话，用户选 7 天却看到「本月比上月多花」，会以为范围开关坏了。 -->
    <text class="hero-note hero-note-sub">跨月对比与固定支出按自然月统计，不受上面的范围影响</text>
  </view>

  <!-- ==================== 分析结果 ==================== -->
  <view class="card sec result-card">

    <view class="card-head">
      <text class="card-title">分析结果</text>
      <text class="more-link" wx:if="{{analyzed && !analyzing && !loadFailed}}" bindtap="onAnalyze">重新分析</text>
    </view>

    <!-- 还没点过：说明按钮能干什么 -->
    <view class="empty-state" wx:if="{{!analyzed}}">
      <image class="empty-icon" src="/assets/icons/empty-chart.png" mode="aspectFit" />
      <text class="empty-text">还没有分析数据</text>
      <text class="empty-text">点上面的按钮，分析最近 {{scopeDays}} 天的收支</text>
    </view>

    <!-- 加载中：骨架而不是空白，否则会以为按钮没生效 -->
    <view class="card sk-card" wx:if="{{analyzing}}">
      <view class="sk-row" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-lines">
          <view class="skeleton sk-line mid"></view>
          <view class="skeleton sk-line short"></view>
        </view>
      </view>
    </view>

    <!-- 失败要与「没有结论」分开：一次网络抖动不该被当成"没有数据" -->
    <view class="empty-state" wx:if="{{loadFailed}}">
      <image class="empty-icon" src="/assets/icons/empty-chart.png" mode="aspectFit" />
      <text class="empty-text">分析失败</text>
      <text class="empty-text">账单没动过，可能是网络问题</text>
      <view class="empty-action">
        <button class="btn-primary btn-sm" bindtap="onAnalyze">重试</button>
      </view>
    </view>

    <!-- 有结论：固定结构卡片，每条都带可核对的依据 -->
    <view class="ins-list" wx:if="{{!analyzing && !loadFailed && insights.length > 0}}">
      <view class="ins" wx:for="{{insights}}" wx:key="id">
        <view class="ins-head">
          <text class="ins-badge bd-{{item.level}}">{{item.levelText}}</text>
        </view>

        <text class="ins-title">{{item.title}}</text>
        <text class="ins-detail">{{item.detail}}</text>

        <view class="ev-list" wx:if="{{item.evidence.length > 0}}">
          <view class="ev" wx:for="{{item.evidence}}" wx:for-item="e" wx:key="label">
            <text class="ev-k">{{e.label}}</text>
            <text class="ev-v num">{{e.value}}</text>
          </view>
        </view>
      </view>

      <view class="ins-foot">
        <text>共 {{insights.length}} 条 · 扫描 {{meta.scanned}} 笔记录{{meta.hasBudget ? ' · 已结合预算' : ''}}</text>
      </view>
    </view>

    <!-- 有账单但一条规则都没触发：如实说"没什么可说的"，不要编一条出来凑数 -->
    <view class="empty-state" wx:if="{{!analyzing && !loadFailed && analyzed && insights.length === 0}}">
      <image class="empty-icon" src="/assets/icons/empty-chart.png" mode="aspectFit" />
      <text class="empty-text">这 {{scopeDays}} 天没有值得说的异常</text>
      <text class="empty-text">规则只在发现明确变化时才会给结论</text>
    </view>
  </view>

  <!-- ==================== 会分析什么 ==================== -->
  <view class="card sec">
    <view class="card-head">
      <text class="card-title">会分析什么</text>
    </view>

    <view class="dims">
      <view class="dim" wx:for="{{dimensions}}" wx:key="key">
        <text class="dim-title">{{item.title}}</text>
        <text class="dim-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="footnote">
    <text>分析只读取你自己的账单（按 openid 隔离），不会与任何其他用户混在一起</text>
  </view>

</view>