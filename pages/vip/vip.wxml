<view class="container theme-{{theme}}">

  <!-- ==================== 会员卡 ==================== -->
  <view class="vip-hero">
    <view class="vh-glow"></view>
    <view class="vh-crown">
      <image class="vh-crown-img" src="/assets/icons/mi-vip.png" mode="aspectFit" />
    </view>

    <block wx:if="{{isVip}}">
      <text class="vh-title">永久会员</text>
      <text class="vh-sub">{{sinceText}} 开通 · 永久有效</text>
      <view class="vh-badge">
        <text class="vh-badge-text">已解锁全部会员功能</text>
      </view>
    </block>

    <block wx:else>
      <text class="vh-title">开通会员</text>
      <text class="vh-sub">一次开通，永久有效 · 解锁智能分析</text>
    </block>
  </view>

  <!-- ==================== 权益对比表 ==================== -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">会员 / 普通用户 功能对比</text>
    </view>

    <view class="cmp">
      <!-- 表头 -->
      <view class="cmp-row cmp-head">
        <text class="cmp-name">功能</text>
        <text class="cmp-col">普通用户</text>
        <text class="cmp-col cmp-col-vip">会员</text>
      </view>

      <view
        class="cmp-row {{index === compare.length - 1 ? 'cmp-row-last' : ''}} {{item.highlight ? 'cmp-row-hl' : ''}}"
        wx:for="{{compare}}"
        wx:key="name"
      >
        <text class="cmp-name">{{item.name}}</text>
        <text class="cmp-col">{{item.free}}</text>
        <text class="cmp-col cmp-col-vip {{item.highlight ? 'cmp-val-vip' : ''}}">{{item.vip}}</text>
      </view>
    </view>
  </view>

  <!-- ==================== 开通 ==================== -->
  <view class="card buy-card" wx:if="{{!isVip}}">
    <view class="buy-price-line">
      <text class="buy-price num">{{priceText}}</text>
      <text class="buy-price-note">一次性买断 · 永久有效</text>
    </view>

    <button
      class="btn-primary btn-buy"
      bindtap="onBuy"
      disabled="{{loading || paying}}"
      hover-class="btn-buy-hover"
    >{{loading ? '开通中…' : (paying ? '请确认…' : '微信支付开通')}}</button>

    <text class="buy-tip">支付由微信提供保障 · 沙箱阶段不产生真实扣款</text>
  </view>

  <!-- ==================== 已开通的权益说明 ==================== -->
  <view class="card" wx:if="{{isVip}}">
    <view class="card-head">
      <text class="card-title">你的会员权益</text>
    </view>
    <view class="own-list">
      <view class="own-item">
        <text class="own-dot">✓</text>
        <text class="own-text">「AI分析」页智能分析完整解锁，分析次数不限</text>
      </view>
      <view class="own-item">
        <text class="own-dot">✓</text>
        <text class="own-text">会员永久有效，无需续费，换手机登录同一微信即恢复</text>
      </view>
      <view class="own-item own-item-last">
        <text class="own-dot">✓</text>
        <text class="own-text">后续新增的分析维度自动包含在会员内</text>
      </view>
    </view>
  </view>

  <view class="footnote">
    <text class="footnote-text">会员权益仅限本微信账号使用 · 如有问题请在「我的-关于」中联系作者</text>
  </view>

</view>
