/* ==========================================================================
   首页
   ========================================================================== */

/* ==================== 顶部概览 Hero ==================== */

.hero {
  position: relative;
  padding: 32rpx 32rpx 72rpx;
  /* 纯色兜底在前、渐变在后：即便渐变解析失败也不会掉成透明。
     首色 = --hero-top，与原生导航栏同色 —— 卡片顶到导航栏下面，两者必须无缝，
     否则中间会露出一条色差带（导航栏颜色由 JS 用同一份值设置）。 */
  background-color: var(--hero-top);
  background-image: var(--hero-grad);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

/* 两团柔光，避免纯色块过于扁平。
   ⚠️ 强度必须克制：底色本身已经够有色彩，柔光一大就变成"花里胡哨的渐变"，
      反而显脏（用户反馈过"渐变很明显搞得很丑"）。 */
.hero-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-a {
  width: 420rpx;
  height: 420rpx;
  right: -140rpx;
  top: -190rpx;
  background: var(--hero-glow);
}

/* 第二团柔光固定为白色：品牌色已经占了第一团，再叠一层同类色会糊成一片 */
.hero-glow-b {
  width: 360rpx;
  height: 360rpx;
  left: -150rpx;
  bottom: -180rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0) 70%);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 44rpx;
}

.hero-greet {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-hi {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--on-hero);
  letter-spacing: 0.5rpx;
}

.hero-date {
  font-size: 24rpx;
  color: var(--on-hero-dim);
}

/* 右上角主行动按钮 */
.hero-cta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 26rpx 0 20rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: var(--on-hero);
  font-size: 26rpx;
  font-weight: 500;
}

.hero-cta-hover {
  background: rgba(255, 255, 255, 0.28);
}

.hero-cta-plus {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 400;
}

/* 结余大数字 */
.hero-balance {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.hero-balance-label {
  font-size: 24rpx;
  color: var(--on-hero-dim);
}

.hero-balance-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: var(--on-hero);
}

.hero-cur {
  font-size: 36rpx;
  font-weight: 500;
  opacity: 0.85;
}

.hero-num {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.1;
}

/* 收支双卡 */
.hero-chips {
  position: relative;
  display: flex;
  gap: 20rpx;
}

.chip {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.chip-label {
  font-size: 22rpx;
  color: var(--on-hero-dim);
}

.chip-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--on-hero);
}

.on-income { color: var(--on-hero-income); }
.on-expense { color: var(--on-hero-expense); }

/* ==================== 预算进度（hero 内） ==================== */

.hero-budget {
  position: relative;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.hero-budget-hover {
  background: rgba(255, 255, 255, 0.2);
}

.hb-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.hb-label {
  font-size: 22rpx;
  color: var(--on-hero-dim);
}

.hb-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--on-hero);
}

/* 进度槽用半透明白底：5 套 hero 的底色都不一样，只有中性的半透明白
   才能保证「还没走完的那一段」在任何主题下都看得出来 */
.hb-track {
  height: 12rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.hb-fill {
  height: 100%;
  border-radius: var(--r-pill);
  transition: width 0.3s ease;
}

/* 安全 = 白（与卡片同族，不抢眼）；接近与已超 = 暖琥珀。
   ⚠️ 已超**不用红**：这张 hero 卡上的红色是「收入」（--on-hero-income），
      同一块卡上两种红表示相反的意思，扫一眼根本分不出是进账还是透支。
      超支与接近的区别交给下面的文案去说。 */
.hb-fill-safe { background: var(--on-hero); }
.hb-fill-near { background: var(--on-hero-warn); }
.hb-fill-over { background: var(--on-hero-warn); }

.hb-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
}

.hb-dim { color: var(--on-hero-dim); }
.hb-em { color: var(--on-hero); font-weight: 600; }
.hb-warn { color: var(--on-hero-warn); font-weight: 600; }

/* ==================== 快捷入口 ==================== */

.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 12rpx;
  margin: -46rpx 24rpx 20rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-2);
  position: relative;
  z-index: 10;
}

.action-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border-radius: var(--r-md);
  padding: 4rpx 0;
}

.action-hover {
  background: var(--surface-3);
}

.action-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-img {
  width: 44rpx;
  height: 44rpx;
}

/* 三个快捷入口的底色跟各自的**图标**同色（图标是固定色的 PNG），
   不跟主题走 —— 否则换到绿色主题时会出现「蓝色图标配浅绿底」的割裂感。
   主页面上真正跟主题走的是上方那块 hero 卡片。
   ⚠️ 所以这里不能用 --brand-soft：它是随主题变的，换到蓝色主题
      就会把青色的预算图标配成浅蓝底。 */
.act-import { background: #E8F0FF; }
.act-add { background: var(--accent-soft); }
.act-budget { background: var(--teal-soft); }

.action-text {
  font-size: 23rpx;
  color: var(--ink-2);
  white-space: nowrap;
}

/* ==================== 通用区块间距 ==================== */

.sec {
  margin: 0 24rpx 20rpx;
}

/* ==================== 近 7 天趋势 ==================== */

.trend-tip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-md);
  background: var(--surface-3);
}

.trend-tip-day {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-1);
  flex-shrink: 0;
}

.trend-tip-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.trend-tip-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.trend-tip-val {
  font-size: 25rpx;
  font-weight: 600;
}

.ti-income { color: var(--income); }
.ti-expense { color: var(--expense); }

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.dot-income { background: var(--income); }
.dot-expense { background: var(--expense); }

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}

/* 单日：两根柱子并排，绘图高度 160rpx（与云函数 CHART_HEIGHT 对应） */
.bar-day {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 0;
  border-radius: var(--r-sm);
  transition: background 0.18s ease;
}

.bar-day.is-active {
  background: var(--brand-soft);
}

.bar-group {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  height: 160rpx;
}

.bar {
  width: 20rpx;
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.3s ease;
}

.bar-income { background: linear-gradient(to top, #E5484D, #FF8A8E); }
.bar-expense { background: linear-gradient(to top, #0E9F6E, #4FD1A0); }

.bar-label {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.bar-day.is-active .bar-label {
  color: var(--brand);
  font-weight: 600;
}

/* ==================== 骨架屏 ==================== */

.sk-list {
  padding: 4rpx 0;
}

/* ==================== 最近交易列表 ==================== */

/* 分组容器：分隔线由 bill-card 的 show-border 控制、行高由卡片自己决定，
   这里只声明分组语义，不加额外间距，避免和卡片内边距叠加。
   写出来是为了不留下「WXML 用了、样式里查不到」的悬空类名。 */
.bill-list {
  display: block;
}
